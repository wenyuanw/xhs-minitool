{
  "name": "sony-shutter",
  "version": "0.1.0",
  "private": true,
  "description": "上传索尼相机原图，本地解析快门次数、机身型号与拍摄参数。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && minitool-pack",
    "preview": "vite preview --port 5174",
    "validate": "minitool-validate xhs-tool --strict",
    "selfcheck": "node ./scripts/selfcheck.mjs"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "xhs-minitool-pack": "workspace:*",
    "xhs-minitool-validate": "workspace:*",
    "xhs-minitool-vite-config": "workspace:*"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
